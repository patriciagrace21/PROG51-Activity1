#include <iostream>
using namespace std;

int main() {
    string product1 = "Rice";
    string product2 = "Bread";
    string product3 = "Milk";

    double price1 = 50.00;
    double price2 = 15.00;
    double price3 = 30.00;

    int stock1 = 20;
    int stock2 = 30;
    int stock3 = 15;

    int choice, quantity;
    double total = 0, payment, change;
    char again;

    do {
        cout << "\n===== INVENTORY SYSTEM / POS =====" << endl;
        cout << "1. View Products" << endl;
        cout << "2. Buy Products" << endl;
        cout << "3. View Inventory" << endl;
        cout << "4. Exit" << endl;
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "\n--- PRODUCT LIST ---" << endl;
                cout << "1. " << product1 << " - PHP " << price1 << endl;
                cout << "2. " << product2 << " - PHP " << price2 << endl;
                cout << "3. " << product3 << " - PHP " << price3 << endl;
                break;

            case 2:
                total = 0;
                do {
                    cout << "\n--- BUY PRODUCTS ---" << endl;
                    // FIXED: Added missing closing quotes around the stock labels below
                    cout << "1. " << product1 << " - PHP " << price1 << " (Stock: " << stock1 << ")" << endl;
                    cout << "2. " << product2 << " - PHP " << price2 << " (Stock: " << stock2 << ")" << endl;
                    cout << "3. " << product3 << " - PHP " << price3 << " (Stock: " << stock3 << ")" << endl;
                    cout << "0. Checkout\n";

                    cout << "Choose product: ";
                    cin >> choice;

                    if (choice == 0) {
                        break;
                    }
                    else if (choice < 1 || choice > 3) {
                        cout << "Invalid product choice!" << endl;
                    }
                    else {
                        cout << "Enter quantity: ";
                        cin >> quantity;

                        if (quantity <= 0) {
                            cout << "Invalid quantity!\n";
                        }
                        else if (choice == 1) {
                            if (quantity <= stock1) {
                                total += price1 * quantity;
                                stock1 -= quantity;
                                cout << product1 << " added to cart." << endl;
                            }
                            else {
                                cout << "Not enough Rice in stock!" << endl;
                            }
                        }
                        else if (choice == 2) {
                            if (quantity <= stock2) {
                                total += price2 * quantity;
                                stock2 -= quantity;
                                cout << product2 << " added to cart." << endl;
                            }
                            else {
                                cout << "Not enough Bread in stock!" << endl;
                            }
                        }
                        else if (choice == 3) {
                            if (quantity <= stock3) {
                                total += price3 * quantity;
                                stock3 -= quantity;
                                cout << product3 << " added to cart." << endl;
                            }
                            else {
                                cout << "Not enough Milk in stock!" << endl;
                            }
                        }
                    }

                } while (true);

                if (total > 0) {
                    cout << "\n===== RECEIPT =====" << endl;
                    cout << "Total: PHP " << total << endl;

                    do {
                        cout << "Enter payment: PHP ";
                        cin >> payment;

                        if (payment < total) {
                            cout << "Insufficient payment!" << endl;
                        }

                    } while (payment < total);

                    change = payment - total;

                    cout << "Payment: PHP " << payment << endl;
                    cout << "Change: PHP " << change << endl;
                    cout << "Thank you for shopping!" << endl;
                }
                else {
                    cout << "No products purchased." << endl;
                }
                break;

            case 3:
                cout << "\n--- INVENTORY REPORT ---" << endl;

                cout << product1 << " | Stock: " << stock1 << endl;
                if (stock1 == 0)
                    cout << "Status: OUT OF STOCK" << endl;
                else if (stock1 <= 5)
                    cout << "Status: LOW STOCK" << endl;
                else
                    cout << "Status: AVAILABLE" << endl;

                cout << product2 << " | Stock: " << stock2 << endl;
                if (stock2 == 0)
                    cout << "Status: OUT OF STOCK" << endl;
                else if (stock2 <= 5)
                    cout << "Status: LOW STOCK" << endl;
                else
                    cout << "Status: AVAILABLE" << endl;

                cout << product3 << " | Stock: " << stock3 << endl;
                if (stock3 == 0)
                    cout << "Status: OUT OF STOCK" << endl;
                else if (stock3 <= 5)
                    cout << "Status: LOW STOCK" << endl;
                else
                    cout << "Status: AVAILABLE" << endl;

                break;

            case 4:
                cout << "Thank you for using the system!" << endl;
                break;

            default:
                cout << "Invalid choice!" << endl;
        }

        if (choice != 4) {
            cout << "\nReturn to main menu? (Y/N): ";
            cin >> again;
        }
        else {
            again = 'N';
        }

    } while (again == 'Y' || again == 'y');

    return 0;
}
